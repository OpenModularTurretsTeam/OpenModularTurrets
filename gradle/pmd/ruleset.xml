<?xml version="1.0" encoding="UTF-8"?>
<!--
  Code quality report: only rules about how hard code is to read and change (complexity, size, nesting,
  coupling), not style. Report only for now (build.gradle.kts: isIgnoreFailures); once the limits are agreed,
  switch that off so new code above them fails the build.
  Thresholds are PMD defaults unless noted.
-->
<ruleset name="OMT code quality"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>Complexity and size limits for Open Modular Turrets.</description>

    <!-- Number of independent paths through a method. -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="15"/>
        </properties>
    </rule>
    <!-- How hard a method is to follow (nesting counts extra). -->
    <rule ref="category/java/design.xml/CognitiveComplexity"/>
    <!-- Combinations of paths; catches methods that are long chains of conditions. -->
    <rule ref="category/java/design.xml/NPathComplexity"/>
    <!-- Size in statements: methods over 60, classes over 500 (PMD default for classes: 1500). -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="methodReportLevel" value="60"/>
            <property name="classReportLevel" value="500"/>
        </properties>
    </rule>
    <!-- if inside if inside if. -->
    <rule ref="category/java/design.xml/AvoidDeeplyNestedIfStmts"/>
    <!-- Methods with 8 or more parameters (PMD default: 10). -->
    <rule ref="category/java/design.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="8"/>
        </properties>
    </rule>
    <!-- Classes that use more than 20 other types. -->
    <rule ref="category/java/design.xml/CouplingBetweenObjects"/>
</ruleset>
