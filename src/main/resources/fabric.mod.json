{
  "schemaVersion": 1,
  "id": "openmodularturrets",
  "version": "${version}",
  "name": "Open Modular Turrets",
  "description": "All a man needs are meat ingots, and big ass turrets. Adds a heap of new turrets and upgrades!",
  "authors": [
    "Poenjabiesous",
    "UntouchedWagons",
    "Keridos"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/openmodularturrets/"
  },
  "license": [
    "MIT",
    "CC-BY-NC-SA-4.0"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "omtteam.openmodularturrets.platform.fabric.OMTFabric"
    ],
    "client": [
      "omtteam.openmodularturrets.client.platform.fabric.OMTFabricClient"
    ],
    "jade": [
      "omtteam.openmodularturrets.compat.jade.OMTJadePlugin"
    ],
    "fabric-datagen": [
      "omtteam.openmodularturrets.datagen.OMTDataGenerator"
    ]
  },
  "mixins": [
    "openmodularturrets.mixins.json",
    {
      "config": "openmodularturrets.client.mixins.json",
      "environment": "client"
    }
  ],
  "suggests": {
    "jade": "*"
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "omlib": ">=${omlib_version}"
  }
}
